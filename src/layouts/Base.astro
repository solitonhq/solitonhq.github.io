---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localeFromPath, switchLocalePath, t } from '../i18n/ui';

interface Props { title: string; description: string; noindex?: boolean; /** Schema.org objects for this page. */ jsonLd?: object | object[]; }
const { title, description, noindex = false, jsonLd } = Astro.props;
// Escape "<" so the data can never close the script tag.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
const locale = localeFromPath(Astro.url.pathname);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = locales.map((l) => ({ l, href: new URL(switchLocalePath(Astro.url.pathname, l), site).href }));
const ogImage = new URL(`/og/${locale}.png`, site).href;
const fullTitle = title === 'Soliton' ? 'Soliton' : `${title} · Soliton`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soliton" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Soliton" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050506" />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body class="flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg">{t(locale, 'nav.skip')}</a>
    <Header locale={locale} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>

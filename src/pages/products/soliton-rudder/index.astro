---
import ProductPage from '../../../components/ProductPage.astro';
import RudderExtras from '../../../components/RudderExtras.astro';
import { products } from '../../../i18n/products';
import { rudder } from '../../../i18n/rudder';

const product = products.find((p) => p.slug === 'rudder')!;
const c = rudder.en;
---
<ProductPage locale="en" product={product} description={c.description} features={c.features}>
  <RudderExtras locale="en" />
</ProductPage>

---
import ProductPage from '../../../../components/ProductPage.astro';
import { products } from '../../../../i18n/products';

export function getStaticPaths() {
  return products
    .map((p) => ({ params: { slug: `soliton-${p.slug}` }, props: { product: p } }));
}
const { product } = Astro.props;
---
<ProductPage locale="tr" product={product} />

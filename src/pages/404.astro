---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you are looking for does not exist.">
  <section class="mx-auto max-w-6xl px-4 py-32 sm:px-6">
    <h1 class="text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-muted">The page you are looking for does not exist or has moved. / Aradığınız sayfa mevcut değil ya da taşınmış.</p>
    <p class="mt-8 flex gap-4"><a class="underline" href="/">Home</a><a class="underline" href="/tr/">Ana sayfa</a></p>
  </section>
</Base>

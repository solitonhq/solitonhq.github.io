---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { rudder, shotOrder, type ShotKey } from '../i18n/rudder';
import { localePath, type Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = rudder[locale];
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/rudder/*.png', { eager: true });
const shot = (k: ShotKey) => images[`../assets/rudder/${k}.png`]!.default;
const [hero, ...rest] = shotOrder;
---
<Base title={c.title} description={c.description}>
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-16 sm:px-6 sm:pt-24">
    <a href={localePath(locale, '/products/')} class="text-sm text-muted hover:text-fg">← {c.back}</a>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">{c.title}</h1>
      <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{c.status}</span>
    </div>
    <p class="mt-6 max-w-2xl text-lg text-muted">{c.lead}</p>
    <p class="mt-3 text-sm text-muted">{c.statusNote}</p>
    <div class="mt-8">
      <a href="https://github.com/solitonhq" rel="noopener" class="inline-block rounded-md bg-accent px-5 py-2.5 font-medium text-accent-fg">{c.ctaGithub}</a>
    </div>
    <figure class="mt-12">
      <Image src={shot(hero!)} alt={c.shots[hero!].alt} widths={[640, 960, 1280, 1600, 2000]} sizes="(min-width: 1152px) 1104px, 100vw" loading="eager" fetchpriority="high" class="w-full rounded-xl border border-line" />
    </figure>
  </section>

  <section class="border-t border-line" aria-labelledby="shots">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 id="shots" class="text-2xl font-semibold tracking-tight">{c.shotsTitle}</h2>
      <p class="mt-2 max-w-2xl text-muted">{c.shotsLead}</p>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        {rest.map((k, i) => (
          <figure class:list={[i === rest.length - 1 && rest.length % 2 === 1 && 'md:col-span-2']}>
            <a href={shot(k).src} target="_blank" rel="noopener" aria-label={c.shots[k].title}>
              <Image src={shot(k)} alt={c.shots[k].alt} widths={[600, 900, 1200, 1600]} sizes="(min-width: 768px) 1104px, 100vw" loading="lazy" class="w-full rounded-lg border border-line" />
            </a>
            <figcaption class="mt-3">
              <h3 class="font-semibold">{c.shots[k].title}</h3>
              <p class="mt-1 text-sm text-muted">{c.shots[k].body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-10 text-xs text-muted">{c.demoNote}</p>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="features">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 id="features" class="text-2xl font-semibold tracking-tight">{c.featuresTitle}</h2>
      <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {c.features.map((f) => (
          <div>
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-muted">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="principles">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 id="principles" class="text-2xl font-semibold tracking-tight">{c.principlesTitle}</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {c.principles.map((p) => (
          <div>
            <h3 class="font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm text-muted">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="install">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2">
      <div>
        <h2 id="install" class="text-2xl font-semibold tracking-tight">{c.installTitle}</h2>
        <p class="mt-3 text-muted">{c.installBody}</p>
        <h3 class="mt-8 font-semibold">{c.requirementsTitle}</h3>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">{c.requirements.map((r) => <li>{r}</li>)}</ul>
      </div>
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">{c.roadmapTitle}</h2>
        <p class="mt-3 text-muted">{c.roadmapLead}</p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">{c.roadmap.map((r) => <li>{r}</li>)}</ul>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import ProductChapter from './ProductChapter.astro';
import ProductStrip from './ProductStrip.astro';
import Notify from './Notify.astro';
import { products, productPath, type Product } from '../i18n/products';
import { home } from '../i18n/home';
import { localePath, type Locale } from '../i18n/ui';
import { softwareLd } from '../seo';
interface Props { locale: Locale; product: Product; }
const { locale, product } = Astro.props;
const h = home[locale].product;
const c = product.copy[locale];
const index = products.findIndex((p) => p.slug === product.slug);
---
<Base title={product.name} description={`${c.tagline} ${c.description}`} jsonLd={softwareLd(product, locale, localePath(locale, productPath(product)))}>
  <script is:inline>document.documentElement.classList.add('js')</script>

  <div class="tk-wrap crumb">
    <a href={localePath(locale, '/products/')}>← {h.back}</a>
  </div>

  <ProductChapter product={product} locale={locale} index={index} page />

  <section class="tk-section tk-rule tk-alt more">
    <div class="tk-wrap">
      <div class="tk-eyebrow">{h.moreTools}</div>
      <div class="gap"><ProductStrip locale={locale} exclude={product.slug} /></div>
    </div>
  </section>

  <Notify locale={locale} />
</Base>

<style>
  .crumb { padding-top: 40px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--fg); }
  .more { padding: 90px 0; }
  .gap { margin-top: 28px; }
</style>

<script>
  import '../scripts/reveal';
</script>

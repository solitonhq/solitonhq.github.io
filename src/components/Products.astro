---
import Base from '../layouts/Base.astro';
import { products, statusLabel } from '../i18n/products';
import { t, type Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<Base title={t(locale, 'products.title')} description={t(locale, 'products.description')}>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h1 class="text-4xl font-semibold tracking-tight">{t(locale, 'products.title')}</h1>
    <p class="mt-4 max-w-2xl text-muted">{t(locale, 'products.lead')}</p>
    <div class="mt-12 divide-y divide-line border-y border-line">
      {products.map((p) => {
        const c = p.copy[locale];
        return (
          <article id={p.slug} class="grid scroll-mt-8 gap-6 py-10 md:grid-cols-[1fr_1.4fr]">
            <div>
              <h2 class="text-2xl font-semibold tracking-tight">{p.name}</h2>
              <p class="mt-2 text-sm text-muted">{t(locale, 'products.status')}: {statusLabel[locale][p.status]}</p>
            </div>
            <div>
              <p class="text-lg font-medium">{c.tagline}</p>
              <p class="mt-2 text-muted">{c.description}</p>
              <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-muted">
                {c.points.map((x) => <li>{x}</li>)}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Base>

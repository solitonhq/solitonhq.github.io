---
import { localePath, type Locale } from '../i18n/ui';
import { statusLabel, type Product } from '../i18n/products';
interface Props { product: Product; locale: Locale; }
const { product, locale } = Astro.props;
const c = product.copy[locale];
---
<article class="relative flex flex-col rounded-xl border border-line bg-surface p-6">
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-lg font-semibold tracking-tight">
      <a class="after:absolute after:inset-0" href={localePath(locale, product.slug === 'rudder' ? '/products/soliton-rudder/' : `/products/#${product.slug}`)}>{product.name}</a>
    </h3>
    <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{statusLabel[locale][product.status]}</span>
  </div>
  <p class="mt-3 font-medium">{c.tagline}</p>
  <p class="mt-2 text-sm text-muted">{c.description}</p>
</article>

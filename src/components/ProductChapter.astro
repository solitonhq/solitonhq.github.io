---
import { Image } from 'astro:assets';
import { statusLabel, productPath, type Feature, type Product } from '../i18n/products';
import { home } from '../i18n/home';
import { localePath, type Locale } from '../i18n/ui';
import { repoStats } from '../stats';
import { site } from '../site';
interface Props { product: Product; locale: Locale; index: number; /** Replace the product's feature cells, e.g. with the longer list on its own page. */ features?: Feature[]; /** Show only the first few feature cells, with a link to the full list on the product page. */ limit?: number; /** Render as the main content of a detail page (h1, no alternating background). */ page?: boolean }
const { product: p, locale, index, page = false, features, limit } = Astro.props;
const c = p.copy[locale];
const h = home[locale].chapter;
const n = (i: number) => String(i).padStart(2, '0');
const incoming = p.status === 'incoming';
const tagClass = incoming ? 'soon' : 'live';
const screens = p.screens ?? [];
const href = (x: string) => (x.startsWith('/') ? localePath(locale, x) : x);

// A single soliton pulse for the "signal incoming" stage, drawn at build time.
const pulse = Array.from({ length: 86 }, (_, i) => {
  const x = i * 4;
  const s = 1 / Math.cosh((x - 170) / 32);
  return `${i ? 'L' : 'M'}${x} ${(100 - s * s * 84).toFixed(1)}`;
}).join('');

const stats = incoming ? null : await repoStats(p.repo);
const fmt = new Intl.NumberFormat(locale === 'tr' ? 'tr-TR' : 'en-US');
const allFeatures = features ?? c.features;
const shownFeatures = limit ? allFeatures.slice(0, limit) : allFeatures;
const moreFeatures = limit && !incoming && allFeatures.length > limit;

const title = incoming ? `${p.name} · ${h.incomingWord}` : `${p.name}${p.seo?.version ? ` ${p.seo.version}` : ''}`;
---
<section class:list={['tk-section', !page && 'tk-rule', !page && index % 2 === 0 && 'tk-alt', 'chapter', page && 'as-page']} id={p.slug}>
  <div class="tk-wrap">
    <div class="tk-head tk-rv">
      <div class="rhead">
        <div class="tk-eyebrow">{n(index + 1)} · {p.name}</div>
        <span class={`tk-tag ${tagClass}`}>{statusLabel[locale][p.status]}</span>
      </div>
      {page ? <h1>{c.headline}</h1> : <h2>{c.headline}</h2>}
      <p>{c.description}</p>
    </div>

    <div class="tk-rv">
      {screens.length > 0 ? (
        <div data-tabs>
          <div class="tabs" role="tablist" aria-label={`${p.short} ${h.screensLabel}`}>
            {screens.map((s, i) => (
              <button type="button" role="tab" id={`${p.slug}-tab-${i}`} aria-controls={`${p.slug}-pane-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <small>{n(i + 1)}</small>{s.copy[locale].label}
              </button>
            ))}
          </div>
          {screens.map((s, i) => (
            <div class="pane" role="tabpanel" id={`${p.slug}-pane-${i}`} aria-labelledby={`${p.slug}-tab-${i}`} hidden={i !== 0}>
              <section class="shotwrap" aria-label={s.copy[locale].label} tabindex="0">
                <div class="frame">
                  <Image src={s.image} alt={s.copy[locale].alt} widths={[720, 960, 1200, 1600]} sizes="(min-width: 1208px) 1110px, max(720px, calc(100vw - 50px))" loading="lazy" />
                </div>
              </section>
              <p class="swipe" aria-hidden="true">{h.swipe}</p>
              <p class="scap"><strong>{s.copy[locale].label}.</strong> {s.copy[locale].body}</p>
            </div>
          ))}
          {!limit && <p class="demo">{p.demoNote?.[locale] ?? h.demoNote}</p>}
        </div>
      ) : (
        <div class="teaser" role="img" aria-label={`${p.name} ${h.teaserLabel}`}>
          <div class="bar"><i></i><i></i><i></i><span>soliton-{p.slug} · {statusLabel[locale][p.status].toLowerCase()}</span></div>
          <div class="word" aria-hidden="true">{p.short}</div>
          <svg viewBox="0 0 800 120" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 100H800" stroke="#272c33" stroke-dasharray="3 6" />
            <g class="pw"><path d={pulse} fill="none" stroke="#5cc8ff" stroke-width="2" /></g>
          </svg>
          <div class="foot">
            <span>{incoming ? h.teaserFoot : statusLabel[locale][p.status].toLowerCase()} {incoming && <em>{h.incomingWord}</em>}{!incoming && <em></em>}</span>
            <span class="hide">{incoming ? h.teaserFootHint : h.teaserNoShots}</span>
          </div>
        </div>
      )}

      {!limit && c.notes && c.notes.length > 0 && (
        <div class="notes">
          {c.notes.map((x) => <div><b>{x.title}</b><span>{x.body}</span></div>)}
        </div>
      )}
    </div>

    {page && <h2 class="sr-only">{h.featuresLabel}</h2>}
    <div class="grid tk-rv">
      {shownFeatures.map((f, i) => (
        <div class="cell"><div class="n">{n(i + 1)}</div><h3>{f.title}</h3><p>{f.body}</p></div>
      ))}
    </div>
    {moreFeatures && <p class="more tk-rv"><a href={localePath(locale, productPath(p))}>{h.allFeatures} ({allFeatures.length}) →</a></p>}

    <div class="get tk-rv">
      <div>
        <div class="tk-eyebrow">{incoming ? h.stayOnWave : h.getIt}</div>
        <h3>{title}</h3>
        <p>{c.blurb}</p>
        <div class="acts">
          {incoming ? (
            <>
              <a class="tk-btn primary" href={p.repo ?? site.githubOrg} rel="noopener">{p.repo ? h.watchGithub : h.followGithub}</a>
              <a class="tk-btn" href={`${localePath(locale)}#notify`}>{h.howNotify}</a>
            </>
          ) : (
            (p.actions ?? []).map((a) => (
              <a class:list={['tk-btn', a.primary && 'primary']} href={href(a.href)} rel={a.external ? 'noopener' : undefined}>{a.label[locale]}</a>
            ))
          )}
        </div>
      </div>
      <div class="term" role="group" aria-label={h.detailsLabel}>
        {c.meta.map((m) => <div><span class="k">{m.k}</span><em class:list={[m.accent && 'a']}>{m.v}</em></div>)}
        {stats && <div><span class="k">★ {h.stars}</span><em><a href={p.repo} rel="noopener">{fmt.format(stats.stars)}</a></em></div>}
        {stats && <div><span class="k">↓ {h.downloads}</span><em>{fmt.format(stats.downloads)}</em></div>}
      </div>
    </div>
  </div>
</section>

<style>
  .tk-head :global(h1) { font-size: clamp(34px, 5.2vw, 64px); line-height: 1.04; letter-spacing: -.035em; font-weight: 600; margin: 16px 0 18px; }
  .as-page { padding-top: 48px; }
  .rhead { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }

  .tabs { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); margin-bottom: 18px; }
  .tabs button { background: var(--bg); border: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font-size: 14px; padding: 14px 16px; cursor: pointer; text-align: left; position: relative; transition: .15s; }
  .tabs button small { display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: .14em; color: var(--dim); margin-bottom: 2px; }
  .tabs button:hover { color: var(--fg); }
  .tabs button[aria-selected='true'] { color: var(--fg); background: var(--surface); }
  .tabs button[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--accent); }
  .pane[hidden] { display: none; }
  .shotwrap { overflow-x: auto; scrollbar-width: thin; }
  .swipe { display: none; color: var(--dim); font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; margin-top: 8px; }
  .frame { border: 1px solid var(--line-2); background: var(--bg); box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .9); }
  .frame :global(img) { width: 100%; height: auto; display: block; }
  .scap { color: var(--muted); font-size: 15px; margin-top: 18px; }
  .demo { color: var(--dim); font-size: 12px; margin-top: 10px; font-family: var(--font-mono); letter-spacing: .02em; }
  .scap strong { color: var(--fg); font-weight: 500; }

  .teaser { position: relative; aspect-ratio: 2000 / 1263; min-height: 340px; border: 1px solid var(--line-2); overflow: hidden;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 80px 80px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 80px 80px,
      radial-gradient(ellipse at 50% 45%, #10151b, var(--bg) 70%);
    box-shadow: 0 60px 120px -30px rgba(0, 0, 0, .9), 0 0 120px -50px color-mix(in srgb, var(--accent) 28%, transparent); }
  .teaser .bar { position: absolute; inset: 0 0 auto 0; height: 38px; border-bottom: 1px solid var(--line-2); background: rgba(5, 5, 6, .7); display: flex; align-items: center; gap: 7px; padding: 0 14px; font-family: var(--font-mono); font-size: 11px; color: var(--dim); letter-spacing: .06em; }
  .teaser .bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); }
  .teaser .bar span { margin-left: 10px; }
  .teaser .word { position: absolute; inset: 38px 0 90px; display: flex; align-items: center; justify-content: center; font-size: clamp(70px, 17vw, 230px); font-weight: 700; letter-spacing: -.05em; text-transform: uppercase; color: transparent; -webkit-text-stroke: 1px #2c343e; user-select: none; }
  .teaser svg { position: absolute; left: 0; right: 0; bottom: 70px; width: 100%; height: 120px; overflow: visible; }
  .teaser .pw { animation: sweep 7s linear infinite; }
  @keyframes sweep { from { transform: translateX(-340px); } to { transform: translateX(960px); } }
  .teaser .foot { position: absolute; inset: auto 0 0 0; padding: 0 22px; height: 56px; border-top: 1px solid var(--line-2); background: rgba(5, 5, 6, .75); display: flex; align-items: center; justify-content: space-between; gap: 16px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); letter-spacing: .04em; }
  .teaser .foot em { font-style: normal; color: var(--accent); }
  .teaser .foot em::after { content: '▌'; margin-left: 4px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 600px) { .teaser .foot .hide { display: none; } }

  .notes { margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .notes div { background: var(--surface); padding: 20px 22px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .notes b { display: block; font-size: 14px; margin-bottom: 2px; }
  .notes span { color: var(--muted); font-size: 13px; }
  @media (max-width: 700px) {
    /* the interface is wide, so let it scroll sideways at a readable size */
    .frame { min-width: 720px; }
    .swipe { display: block; }
  }

  .more { margin-top: 18px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
  .more a { color: var(--accent); }
  .more a:hover { text-decoration: underline; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); margin-top: 56px; }
  .cell { position: relative; background: var(--bg); padding: 26px 24px 30px; transition: background .2s; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .tk-alt .cell { background: var(--bg-2); }
  .cell::after { content: ''; position: absolute; left: 0; top: 0; height: 2px; width: 0; background: var(--accent); transition: width .35s; }
  .cell:hover::after { width: 100%; }
  .cell:hover, .tk-alt .cell:hover { background: var(--surface); }
  .cell .n { font-family: var(--font-mono); font-size: 11px; color: var(--accent); letter-spacing: .14em; margin-bottom: 40px; }
  .cell h3 { font-size: 17px; font-weight: 600; margin-bottom: 8px; letter-spacing: -.01em; }
  .cell p { font-size: 14px; color: var(--muted); }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }

  .get { display: grid; grid-template-columns: 1.1fr .9fr; gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 56px; }
  .get > div { background: var(--bg); padding: 38px; }
  .tk-alt .get > div { background: var(--bg-2); }
  .get h3 { font-size: 24px; letter-spacing: -.02em; margin: 14px 0 12px; }
  .get p { color: var(--muted); font-size: 15px; margin-bottom: 24px; }
  .acts { display: flex; gap: 12px; flex-wrap: wrap; }
  .term { font-family: var(--font-mono); font-size: 13px; color: var(--muted); line-height: 2; }
  .term div { border-bottom: 1px dashed var(--line); padding: 6px 0; display: flex; justify-content: space-between; gap: 20px; }
  .term div:last-child { border: 0; }
  .term .k { color: var(--dim); }
  .term em { font-style: normal; color: var(--fg); text-align: right; }
  .term em.a { color: var(--accent); }
  @media (max-width: 860px) { .get { grid-template-columns: 1fr; } .get > div { padding: 26px 20px; } }
</style>

<script>
  // Screenshot tabs: one panel visible at a time, arrow keys move between tabs.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((b) => {
        const on = b === tab;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const pane = document.getElementById(b.getAttribute('aria-controls')!);
        if (pane) pane.hidden = !on;
      });
    };
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => select(b));
      b.addEventListener('keydown', (e) => {
        const next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
        if (next === null) return;
        e.preventDefault();
        const t = tabs[(next + tabs.length) % tabs.length]!;
        t.focus();
        select(t);
      });
    });
  });
</script>

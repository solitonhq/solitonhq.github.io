---
import Logo from './Logo.astro';
import { products, productPath, statusLabel } from '../i18n/products';
import { localePath, switchLocalePath, t, type Locale, type UIKey } from '../i18n/ui';
import { site } from '../site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'tr' : 'en';
const home = localePath(locale);
const path = (p: string) => localePath(locale, p);

interface Child { label: string; href: string; hint?: string }
interface Item { key: UIKey; href: string; external?: boolean; children?: Child[] }
const items: Item[] = [
  {
    key: 'nav.products',
    href: path('/products/'),
    children: [
      ...products.map((p) => ({ label: p.name, href: path(productPath(p)), hint: statusLabel[locale][p.status] })),
      { label: `${t(locale, 'nav.allProducts')} →`, href: path('/products/') },
    ],
  },
  {
    key: 'nav.about',
    href: path('/about/'),
    children: [
      { label: t(locale, 'nav.about'), href: path('/about/') },
      { label: t(locale, 'nav.approach'), href: `${path('/about/')}#approach` },
      { label: t(locale, 'nav.brand'), href: path('/brand/') },
      { label: t(locale, 'nav.openSource'), href: path('/open-source/') },
      { label: t(locale, 'nav.faq'), href: `${home}#faq` },
    ],
  },
  { key: 'nav.contact', href: path('/contact/') },
  { key: 'nav.github', href: site.githubOrg, external: true },
];
const notify = `${home}#notify`;
const langHref = switchLocalePath(Astro.url.pathname, other);
---
<header class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-[60px] max-w-[1160px] items-center justify-between gap-4 px-6">
    <a href={home} class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[.32em]">
      <Logo size={28} />
      <span>Soliton</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 text-sm text-muted md:flex">
      {items.map((i, n) =>
        i.children ? (
          <div class="menu-root relative flex items-center" data-menu data-open="false">
            <a class="py-4 hover:text-fg" href={i.href}>{t(locale, i.key)}</a>
            <button
              type="button"
              class="ml-1 grid size-6 place-items-center rounded-sm hover:text-fg"
              aria-expanded="false"
              aria-controls={`submenu-${n}`}
              aria-label={`${t(locale, i.key)}: ${t(locale, 'nav.menu')}`}
            >
              <svg class="chev size-3 opacity-60 transition" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
            </button>
            <div id={`submenu-${n}`} class="panel invisible absolute left-1/2 top-full z-50 w-64 -translate-x-1/2 opacity-0 transition duration-150">
              <div class="border border-line-2 bg-surface p-1.5 shadow-2xl shadow-black/60">
                {i.children.map((c) => (
                  <a class="flex items-center justify-between gap-3 px-3 py-2.5 hover:bg-bg-2 hover:text-fg" href={c.href}>
                    <span>{c.label}</span>
                    {c.hint && <span class="font-mono text-[10px] uppercase tracking-[.12em] text-dim">{c.hint}</span>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="hover:text-fg" href={i.href} rel={i.external ? 'noopener' : undefined}>{t(locale, i.key)}</a>
        ),
      )}
      <a class="rounded-sm border border-line-2 px-2.5 py-1 text-fg hover:border-fg" href={langHref} hreflang={other} lang={other}>{t(locale, 'lang.switch')}</a>
      <a class="tk-btn primary sm" href={notify}>{t(locale, 'nav.notify')}</a>
    </nav>

    <div class="flex items-center gap-3 md:hidden">
      <a class="rounded-sm border border-line-2 px-2.5 py-1 text-sm text-fg" href={langHref} hreflang={other} lang={other}>{t(locale, 'lang.switch')}</a>
      <details class="menu relative">
        <summary class="cursor-pointer list-none rounded-sm border border-line-2 px-3 py-1 text-sm">{t(locale, 'nav.menu')}</summary>
        <nav aria-label={t(locale, 'nav.menu')} class="absolute right-0 top-full mt-3 flex max-h-[80dvh] w-64 flex-col overflow-y-auto border border-line-2 bg-surface p-2 text-sm shadow-2xl shadow-black/60">
          {items.map((i) => (
            <>
              <a class="px-3 py-2.5 text-fg" href={i.href} rel={i.external ? 'noopener' : undefined}>{t(locale, i.key)}</a>
              {i.children?.filter((c) => c.href !== i.href).map((c) => (
                <a class="flex items-center justify-between gap-3 py-2 pl-7 pr-3 text-muted hover:text-fg" href={c.href}>
                  <span>{c.label}</span>
                  {c.hint && <span class="font-mono text-[10px] uppercase tracking-[.12em] text-dim">{c.hint}</span>}
                </a>
              ))}
            </>
          ))}
          <a class="tk-btn primary sm mt-2 justify-center" href={notify}>{t(locale, 'nav.notify')}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .menu summary::-webkit-details-marker { display: none; }
  .menu-root[data-open='true'] .panel { visibility: visible; opacity: 1; }
  .menu-root[data-open='true'] .chev { transform: rotate(180deg); }
</style>

<script>
  // Desktop submenus: open on mouse hover, keyboard focus or tap; Escape closes. aria-expanded follows the state.
  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((root) => {
    const btn = root.querySelector('button')!;
    let timer = 0;
    let skipFocus = false;
    const set = (open: boolean) => {
      clearTimeout(timer);
      root.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    };
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') set(true); });
    root.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') timer = window.setTimeout(() => set(false), 120); });
    root.addEventListener('focusin', (e) => { if (!skipFocus && (e.target as HTMLElement).matches(':focus-visible')) set(true); });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node | null)) set(false); });
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); skipFocus = true; btn.focus(); skipFocus = false; } });
    btn.addEventListener('click', () => set(root.dataset.open !== 'true'));
    document.addEventListener('pointerdown', (e) => { if (!root.contains(e.target as Node)) set(false); });
  });

  // Close the mobile menu after picking an in-page link.
  document.querySelectorAll<HTMLDetailsElement>('details.menu').forEach((d) => {
    d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (d.open = false)));
  });
</script>

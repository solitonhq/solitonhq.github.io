---
import { statusLabel, productPath, type Product } from '../i18n/products';
import { home } from '../i18n/home';
import { localePath, type Locale } from '../i18n/ui';
interface Props { locale: Locale; items: Product[]; }
const { locale, items } = Astro.props;
const h = home[locale].incoming;
const view = home[locale].product.viewDetails;
---
<section class="tk-section tk-rule tk-alt" id="incoming">
  <div class="tk-wrap">
    <div class="tk-head tk-rv">
      <div class="rhead"><div class="tk-eyebrow">{h.eyebrow}</div></div>
      <h2>{h.title}</h2>
      <p>{h.lead}</p>
    </div>
    <div class="cards tk-rv">
      {items.map((p) => {
        const c = p.copy[locale];
        return (
          <article class="card" id={p.slug}>
            <div class="top">
              <span class:list={['tk-tag', p.status === 'incoming' ? 'soon' : 'live']}>{statusLabel[locale][p.status]}</span>
            </div>
            <h3><a href={localePath(locale, productPath(p))}>{p.name}</a></h3>
            <p class="tag">{c.tagline}</p>
            <ul>
              {c.features.map((f) => <li>{f.title}</li>)}
            </ul>
            <span class="more">{view} →</span>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .rhead { display: flex; align-items: center; gap: 16px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .card { position: relative; overflow: hidden; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg-2); padding: 28px 26px 30px; display: flex; flex-direction: column; transition: background .2s; }
  .card:hover { background: var(--surface); }
  .card::before { content: ''; position: absolute; left: 0; top: 0; width: 0; height: 2px; background: var(--accent); transition: width .35s; }
  .card:hover::before { width: 100%; }
  .top { display: flex; justify-content: flex-end; align-items: center; margin-bottom: 44px; position: relative; }
  h3 { font-size: 24px; letter-spacing: -.02em; font-weight: 600; position: relative; }
  h3 a::after { content: ''; position: absolute; inset: -200px -26px -200px -26px; }
  .tag { margin-top: 6px; color: var(--fg); font-weight: 500; position: relative; }
  ul { list-style: none; margin: 22px 0 28px; display: grid; gap: 6px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); position: relative; }
  li::before { content: '› '; color: var(--accent); }
  .more { margin-top: auto; font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); position: relative; }
  .card:hover .more { color: var(--accent); }
</style>

---
import { faq } from '../i18n/faq';
import { localePath, type Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = faq[locale];
---
<section class="tk-section tk-rule" id="faq">
  <div class="tk-wrap">
    <div class="tk-head tk-rv">
      <div class="tk-eyebrow">{c.eyebrow}</div>
      <h2>{c.title}</h2>
      <p>{c.lead}</p>
    </div>
    <div class="list tk-rv">
      {c.items.map((it) => (
        <details>
          <summary>{it.q}</summary>
          <div class="a">
            <p>{it.a}</p>
            {it.links && (
              <p class="links">{it.links.map((l) => <a href={localePath(locale, l.href)}>{l.label} →</a>)}</p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .list { max-width: 820px; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 20px 0; font-size: 18px; font-weight: 500; letter-spacing: -.01em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-family: var(--font-mono); color: var(--accent); font-size: 20px; line-height: 1; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover { color: var(--accent); }
  .a { padding: 0 0 22px; max-width: 70ch; color: var(--muted); }
  .links { margin-top: 12px; display: flex; gap: 22px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .links a { color: var(--fg); }
  .links a:hover { color: var(--accent); }
</style>
